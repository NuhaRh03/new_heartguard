/**
 * @fileoverview Firestore Security Rules for PulseGuard Application
 *
 * Core Philosophy:
 * This ruleset enforces a hierarchical data ownership model. Doctors can only manage their own profile data.
 * Patient data and associated subcollections (sensorData, alerts, anomalyData) are scoped to individual patients.
 * Access control is primarily enforced through path-based checks (`patientId` and `doctorId`) and the `request.auth.uid`.
 * To improve performance and security, the `doctorId` is denormalized onto the Patient document to avoid extra reads in security rules.
 *
 * Data Structure:
 * - /doctors/{doctorId}: Stores doctor profiles.
 * - /patients/{patientId}: Stores patient profiles, including the denormalized `doctorId`.
 * - /patients/{patientId}/sensorData/{sensorDataId}: Stores sensor data for each patient.
 * - /patients/{patientId}/alerts/{alertId}: Stores alerts generated for each patient.
 * - /patients/{patientId}/anomalyData/{anomalyDataId}: Stores anomaly data detected for each patient.
 *
 * Key Security Decisions:
 * - Doctors can only read and write their own profile data.
 * - Patient data is only readable by the doctor associated with them.
 * - Patients can only be created by an authenticated doctor.
 * - SensorData, Alerts, and AnomalyData are only accessible within the scope of their parent patient by the associated doctor.
 * - Timestamp fields are NOT validated in this prototyping phase.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /doctors/{doctorId} {
      function isOwner() {
        return isSignedIn() && request.auth.uid == doctorId;
      }

      allow read, update, delete: if isOwner();
      allow create: if isSignedIn() && request.auth.uid == doctorId;
      allow list: if false; // Do not allow listing all doctors
    }

    match /patients/{patientId} {
       function isAssociatedDoctor() {
        return isSignedIn() && resource.data.doctorId == request.auth.uid;
      }
      
      // Allow a doctor to list the patients associated with them
      allow list: if isSignedIn() && request.query.limit <= 100;
      allow get: if isAssociatedDoctor();
      allow create: if isSignedIn() && request.resource.data.doctorId == request.auth.uid;
      allow update, delete: if isAssociatedDoctor();
    }

    match /patients/{patientId}/{subcollection}/{docId} {
      function isAssociatedDoctorForPatient() {
        let patientDoc = get(/databases/$(database)/documents/patients/$(patientId));
        return isSignedIn() && patientDoc.data.doctorId == request.auth.uid;
      }

      allow read: if isAssociatedDoctorForPatient();
      allow write: if false; // Subcollections are read-only from the client side for now
    }
  }
}
