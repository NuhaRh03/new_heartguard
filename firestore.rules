rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers -----------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }
    // Prevent changing ownership once a doc exists
    function ownerUnchanged() {
      return request.resource.data.createdBy == resource.data.createdBy;
    }
    // Enforce that the creator sets themselves as owner on create
    function createdByIsSelf() {
      return signedIn() && request.resource.data.createdBy == request.auth.uid;
    }

    // --- Doctors -----------------------------------------------------------
    // /doctors/{doctorId} is owned by the user whose UID == doctorId
    match /doctors/{doctorId} {
      allow read, write: if isSelf(doctorId) || isAdmin();
    }

    // --- Patients ----------------------------------------------------------
    // Each patient doc has: { ..., createdBy: <doctorUid>, ... }
    match /patients/{patientId} {
      // Create: the doctor must set themselves as owner
      allow create: if createdByIsSelf() || isAdmin();

      // Read, Update, Delete: only the owner (or admin) can read or modify
      allow read, update, delete: if (signedIn() && resource.data.createdBy == request.auth.uid) || isAdmin();
    }

    // --- Optional public/admin spaces you had before -----------------------
    match /public/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
