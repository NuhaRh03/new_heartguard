rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(docData) {
      return isSignedIn() && request.auth.uid == docData.createdBy;
    }

    // Doctor profiles can be read by anyone but only written by the owner
    match /doctors/{doctorId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == doctorId;
    }

    // Patients can only be created by a signed-in user for themselves.
    // They can only be read, updated, or deleted by the user who created them.
    match /patients/{patientId} {
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow read, update, delete: if isOwner(resource.data);

      // Sensor data can be created by the patient's owner.
      // It can be read by the patient's owner.
      match /sensorData/{readingId} {
        allow create: if isOwner(get(/databases/$(database)/documents/patients/$(patientId)).data);
        allow read: if isOwner(get(/databases/$(database)/documents/patients/$(patientId)).data);
        allow write: if false; // Disallow updates/deletes for data integrity
      }
    }
  }
}
