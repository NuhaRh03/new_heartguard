rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers -----------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }
    // Prevent changing ownership once a doc exists
    function ownerUnchanged() {
      return request.resource.data.createdBy == resource.data.createdBy;
    }
    // Enforce that the creator sets themselves as owner on create
    function createdByIsSelf() {
      return signedIn() && request.resource.data.createdBy == request.auth.uid;
    }

    // --- Doctors -----------------------------------------------------------
    // /doctors/{doctorId} is owned by the user whose UID == doctorId
    match /doctors/{doctorId} {
      // Create own profile; optional "id" field must match doc id if present
      allow create: if isSelf(doctorId)
                    && (!('id' in request.resource.data) || request.resource.data.id == doctorId);

      // Read/update/delete own profile; keep "id" consistent if you store it
      allow read, update, delete: if isSelf(doctorId)
                    && (!('id' in request.resource.data) || request.resource.data.id == doctorId);

      // Admins may do anything here (optional)
      allow read, write: if isAdmin();
    }

    // --- Patients ----------------------------------------------------------
    // Each patient doc has: { ..., createdBy: <doctorUid>, ... }
    match /patients/{patientId} {
      // Create: the doctor must set themselves as owner
      allow create: if createdByIsSelf() || isAdmin();

      // Read: only the owner (or admin) can read this patient
      // NOTE: this condition applies to both get() and queries (lists)
      allow read: if (signedIn() && resource.data.createdBy == request.auth.uid) || isAdmin();

      // Update/delete: only owner can modify, and owner cannot be changed
      allow update, delete: if (signedIn() && resource.data.createdBy == request.auth.uid && ownerUnchanged())
                            || isAdmin();
    }

    // --- Optional public/admin spaces you had before -----------------------
    match /public/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
