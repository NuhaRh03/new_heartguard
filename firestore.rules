/**
 * @fileOverview Firestore Security Rules for HeartGuard Application.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model where authenticated users (doctors) can manage their own
 * profiles and the patient data they create. It uses a top-level `patients` collection, with access
 * controlled by a `createdBy` field on each patient document.
 *
 * Data Structure:
 * - /doctors/{doctorId}: Stores doctor profile information. The `doctorId` must match the authenticated user's UID.
 * - /patients/{patientId}: Stores patient profiles. Access is determined by matching `request.auth.uid` with the `createdBy` field.
 * - /patients/{patientId}/sensorData/{readingId}: Stores sensor readings. Access is determined by matching `request.auth.uid` with the `collectedBy` field.
 *
 * Key Security Decisions:
 * - Doctors can only create, read, update, and delete their own doctor profile.
 * - Doctors can create new patients, where the `createdBy` field must match their UID.
 * - Doctors can only read, update, or delete patients they have created.
 * - Doctors can list all patients, but Firestore queries in the app must filter by `createdBy` to enforce visibility.
 * - Doctors can manage sensor data for any patient, but the `collectedBy` field must match their UID, ensuring they only add data on behalf of themselves.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to doctor profile documents. Only the owner can access their profile.
     * @path /doctors/{doctorId}
     */
    match /doctors/{doctorId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == doctorId;
      }
      
      allow read, update, delete: if isOwner() && resource.data.id == doctorId;
      allow create: if isOwner() && request.resource.data.id == doctorId;
    }

    /**
     * @description Controls access to the top-level patients collection.
     * @path /patients/{patientId}
     */
    match /patients/{patientId} {
      // Any authenticated user (doctor) can create a new patient record.
      // The `createdBy` field MUST be set to their own UID.
      allow create: if request.auth != null && request.resource.data.createdBy == request.auth.uid;

      // Only the doctor who created the patient can read, update, or delete it.
      allow get, update, delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
      
      // Allow listing of patients. The application MUST enforce filtering by createdBy == request.auth.uid.
      allow list: if request.auth != null;
    }

    /**
     * @description Controls access to sensor data for a patient.
     * @path /patients/{patientId}/sensorData/{readingId}
     */
    match /patients/{patientId}/sensorData/{readingId} {
       // A doctor can create sensor data if the `collectedBy` field is their own UID.
       // This assumes a doctor might add data for a patient another doctor created, but the data point is owned by the collector.
       allow create: if request.auth != null && request.resource.data.collectedBy == request.auth.uid;

       // Only the doctor who collected the sensor reading can read, update, or delete it.
       allow get, update, delete: if request.auth != null && resource.data.collectedBy == request.auth.uid;
       
       // Allow listing sensor data. App must filter by `collectedBy`.
       allow list: if request.auth != null;
    }
  }
}
